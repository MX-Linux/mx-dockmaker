#!/bin/bash

set -e

cd "$(dirname "${BASH_SOURCE[0]}")"
APPNAME="$(basename "$(dirname "$PWD")")-desktop"
if ! command -v tx >/dev/null; then
    echo "Transifex client (tx) is required to refresh translations." >&2
    exit 1
fi

# prepare transifex 
if [ ! -s  .tx/config ]; then
   mkdir -p .tx
   cat <<EOF > .tx/config
[main]
host = https://www.transifex.com

[o:anticapitalista:p:antix-development:r:$APPNAME]
file_filter = po/${APPNAME}_<lang>.po
source_file = ${APPNAME}.pot
source_lang = en
type = po
EOF
fi    


stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
mkdir -p "$stage/.tx" "$stage/po"
cp .tx/config "$stage/.tx/config"
cp "pot/${APPNAME}.pot" "$stage/${APPNAME}.pot"
(cd "$stage" && tx pull -r "antix-development.$APPNAME" --all)

mkdir -p po
rsync -a --checksum --delay-updates --delete-delay \
    --include="/${APPNAME}_*.po" --exclude='*' "$stage/po/" po/
